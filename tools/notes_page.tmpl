<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$title · Nguyễn Khôi Nguyên (Alan)</title>
  <meta name="description" content="$summary">
  <meta property="og:title" content="$title">
  <meta property="og:description" content="$summary">
  <meta property="og:type" content="article">
  <link rel="icon" href="../../favicon.ico?v=2" sizes="any">
  <link rel="apple-touch-icon" href="../../apple-touch-icon.png?v=2">
  <link rel="stylesheet" href="../../css/site.css?v=$css_v">
  <link rel="stylesheet" href="../../css/notes.css?v=$notes_v">
  <script>
    try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body class="notes-body">
<a class="skip" href="#pages">Skip to the pages</a>

<div class="notes-reader" data-count="$count" data-ratio="$w / $h">

  <aside class="notes-toc" aria-label="Contents">
    <p class="notes-toc-title">Contents</p>
    <nav class="notes-toc-list"></nav>
  </aside>

  <main id="pages" class="notes-pages" tabindex="-1" aria-label="$title, $count pages"></main>
</div>

<div class="notes-bar" role="toolbar" aria-label="Page navigation">
  <button type="button" class="notes-toc-btn" aria-expanded="false">Contents</button>
  <button type="button" class="notes-prev" aria-label="Previous page">‹</button>
  <label>Page <input class="notes-page" type="number" min="1" max="$count" value="1" inputmode="numeric"> of $count</label>
  <button type="button" class="notes-next" aria-label="Next page">›</button>
</div>

<script src="../../js/site.js?v=$js_v"></script>
<script src="../../js/notes.js?v=$notes_v"></script>
</body>
</html>
